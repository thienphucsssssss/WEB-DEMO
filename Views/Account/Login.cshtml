@model KT_LTWEB.Models.ViewModels.LoginViewModel
@using Microsoft.AspNetCore.Identity
@inject SignInManager<IdentityUser> SignInManager
@{
    ViewData["Title"] = "Đăng nhập";
    var externalLogins = (await SignInManager.GetExternalAuthenticationSchemesAsync()).ToList();
}

<div class="row justify-content-center align-items-center py-5">
    <div class="col-md-6 col-lg-5">
        <div class="card border-0 shadow-lg" style="border-radius: 20px;">
            <div class="card-header border-0 text-center text-white py-4"
                 style="background: linear-gradient(135deg, #4f46e5 0%, #06b6d4 100%); border-radius: 20px 20px 0 0;">
                <h3 class="fw-bold mb-1">Đăng Nhập</h3>
                <p class="mb-0 opacity-80" style="font-size: 0.9rem;">Truy cập hệ thống đăng ký học phần</p>
            </div>

            <div class="card-body p-4 p-md-5">
                @if (TempData["Error"] != null)
                {
                    <div class="alert alert-danger border-0 mb-4" role="alert" style="border-radius: 10px; background: rgba(220, 53, 69, 0.1); color: #dc3545; font-size: 0.9rem;">
                        <i class="bi bi-exclamation-circle-fill me-2"></i> @TempData["Error"]
                    </div>
                }

                <form asp-action="Login" method="post">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3" style="font-size: 0.9rem;"></div>

                    <div class="mb-3">
                        <label asp-for="Username" class="form-label fw-medium text-secondary"></label>
                        <div class="input-group">
                            <span class="input-group-text bg-light border-end-0 text-secondary" style="border-radius: 10px 0 0 10px;">
                                <i class="bi bi-person"></i>
                            </span>
                            <input asp-for="Username" class="form-control bg-light border-start-0 px-3"
                                   placeholder="Nhập tên tài khoản" style="border-radius: 0 10px 10px 0; height: 48px;" />
                        </div>
                        <span asp-validation-for="Username" class="text-danger" style="font-size: 0.8rem;"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Password" class="form-label fw-medium text-secondary"></label>
                        <div class="input-group">
                            <span class="input-group-text bg-light border-end-0 text-secondary" style="border-radius: 10px 0 0 10px;">
                                <i class="bi bi-lock"></i>
                            </span>
                            <input asp-for="Password" type="password" class="form-control bg-light border-start-0 px-3"
                                   placeholder="Nhập mật khẩu" style="border-radius: 0 10px 10px 0; height: 48px;" />
                        </div>
                        <span asp-validation-for="Password" class="text-danger" style="font-size: 0.8rem;"></span>
                    </div>

                    <div class="mb-4 d-flex justify-content-between align-items-center">
                        <div class="form-check">
                            <input asp-for="RememberMe" class="form-check-input" style="cursor: pointer;" />
                            <label asp-for="RememberMe" class="form-check-label text-secondary" style="cursor: pointer; font-size: 0.9rem;"></label>
                        </div>
                    </div>

                    <button type="submit" class="btn btn-primary w-100 fw-bold py-2 mb-3 shadow"
                            style="border-radius: 10px; height: 48px; background: linear-gradient(135deg, #4f46e5 0%, #6366f1 100%); border: none;">
                        Đăng Nhập
                    </button>
                </form>

                @if (externalLogins.Count > 0)
                {
                    <div class="text-center my-4 position-relative">
                        <hr class="text-muted" />
                        <span class="position-absolute top-50 start-50 translate-middle bg-white px-3 text-secondary" style="font-size: 0.85rem;">Hoặc đăng nhập bằng</span>
                    </div>

                    <form asp-action="ExternalLogin" method="post" class="text-center">
                        @foreach (var provider in externalLogins)
                        {
                            if (provider.Name == "Google")
                            {
                                <button type="submit" name="provider" value="@provider.Name"
                                        class="btn btn-outline-danger w-100 fw-medium d-flex align-items-center justify-content-center border-2"
                                        style="border-radius: 10px; height: 48px; transition: all 0.2s;">
                                    <i class="bi bi-google me-2 fs-5"></i> Tài khoản Google
                                </button>
                            }
                            else
                            {
                                <button type="submit" name="provider" value="@provider.Name"
                                        class="btn btn-outline-secondary w-100 fw-medium mb-2" style="border-radius: 10px; height: 48px;">
                                    @provider.DisplayName
                                </button>
                            }
                        }
                    </form>
                }

                <div class="text-center text-secondary mt-4" style="font-size: 0.9rem;">
                    <span>Chưa có tài khoản? </span>
                    <a asp-action="Register" class="fw-bold text-decoration-none" style="color: #4f46e5;">Đăng ký ngay</a>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
