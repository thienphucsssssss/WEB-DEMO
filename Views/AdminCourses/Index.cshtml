@model IEnumerable<KT_LTWEB.Models.Course>
@{
    ViewData["Title"] = "Quản lý học phần - Admin";
}

<div class="container py-4">
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show border-0 shadow-sm mb-4" role="alert" style="border-radius: 12px; background: rgba(25, 135, 84, 0.1); color: #198754;">
            <i class="bi bi-check-circle-fill me-2"></i> @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="h3 fw-bold text-dark mb-1">Quản Lý Học Phần</h1>
            <p class="text-secondary mb-0">Thêm, sửa, xóa và theo dõi danh sách học phần trong hệ thống.</p>
        </div>
        <a asp-action="Create" class="btn btn-primary rounded-pill px-4 fw-bold shadow-sm" style="background: #4f46e5; border: none;">
            <i class="bi bi-plus-circle me-1"></i> Thêm Học Phần Mới
        </a>
    </div>

    <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
        <div class="table-responsive">
            <table class="table align-middle mb-0">
                <thead style="background-color: #f8fafc;">
                    <tr class="text-secondary small text-uppercase">
                        <th class="ps-4 py-3" style="width: 80px;">Hình ảnh</th>
                        <th class="py-3">Tên học phần</th>
                        <th class="py-3">Danh mục</th>
                        <th class="py-3">Số tín chỉ</th>
                        <th class="py-3">Giảng viên</th>
                        <th class="py-3">Trạng thái</th>
                        <th class="pe-4 py-3 text-end" style="width: 240px;">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="7" class="text-center py-5">
                            <i class="bi bi-journal-x display-4 text-muted d-block mb-3"></i>
                            <span class="text-muted">Chưa có học phần nào trong hệ thống.</span>
                        </td>
                    </tr>
                }
                else
                {
                    foreach (var item in Model)
                    {
                        <tr>
                            <td class="ps-4">
                                <div class="rounded overflow-hidden bg-light border" style="width: 56px; height: 56px;">
                                    @if (!string.IsNullOrEmpty(item.Image))
                                    {
                                        <img src="@item.Image" alt="@item.Name" class="w-100 h-100 object-fit-cover" />
                                    }
                                    else
                                    {
                                        <div class="w-100 h-100 d-flex align-items-center justify-content-center text-muted">
                                            <i class="bi bi-image"></i>
                                        </div>
                                    }
                                </div>
                            </td>
                            <td class="fw-bold text-dark">@item.Name</td>
                            <td>
                                <span class="badge bg-light text-dark border px-3 py-2" style="border-radius: 20px;">
                                    @(item.Category?.Name ?? "General")
                                </span>
                            </td>
                            <td>
                                <span class="fw-bold text-dark">@item.Credits</span> tín chỉ
                            </td>
                            <td class="text-secondary">@item.Lecturer</td>
                            <td>
                                @if (item.IsActive)
                                {
                                    <span class="badge bg-success-subtle text-success border border-success-subtle px-3 py-2 rounded-pill">
                                        <i class="bi bi-check-circle-fill me-1"></i> Đang mở
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-danger-subtle text-danger border border-danger-subtle px-3 py-2 rounded-pill">
                                        <i class="bi bi-eye-slash-fill me-1"></i> Đã đóng/ẩn
                                    </span>
                                }
                            </td>
                            <td class="pe-4 text-end">
                                <div class="btn-group" role="group">
                                    <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-light border text-dark fw-medium">
                                        Chi tiết
                                    </a>
                                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-light border text-primary fw-medium">
                                        Sửa
                                    </a>
                                    <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-light border text-danger fw-medium">
                                        Xóa
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                }
                </tbody>
            </table>
        </div>
    </div>
</div>
