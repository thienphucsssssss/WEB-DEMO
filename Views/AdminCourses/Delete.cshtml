@model KT_LTWEB.Models.Course
@{
    ViewData["Title"] = "Xóa học phần - Admin";
}

<div class="row justify-content-center py-4">
    <div class="col-lg-6">
        <div class="card border-0 shadow-lg rounded-4 overflow-hidden">
            <!-- Header -->
            <div class="card-header border-0 bg-danger text-white py-4 text-center">
                <i class="bi bi-exclamation-triangle display-4 mb-2 d-block"></i>
                <h3 class="fw-bold mb-1">Xác Nhận Xóa</h3>
                <p class="mb-0 opacity-80" style="font-size: 0.9rem;">Hành động này không thể hoàn tác!</p>
            </div>

            <!-- Body -->
            <div class="card-body p-4 p-md-5 text-center">
                <p class="fs-5 mb-4 text-dark">Bạn có chắc chắn muốn xóa học phần này không?</p>

                <!-- Course details summary -->
                <div class="bg-light p-4 rounded-4 mb-4 text-start">
                    <h5 class="fw-bold text-dark mb-3 text-center">@Model.Name</h5>
                    <div class="row g-2 text-secondary" style="font-size: 0.95rem;">
                        <div class="col-6 text-end fw-bold">ID:</div>
                        <div class="col-6">@Model.Id</div>
                        <div class="col-6 text-end fw-bold">Số tín chỉ:</div>
                        <div class="col-6">@Model.Credits</div>
                        <div class="col-6 text-end fw-bold">Giảng viên:</div>
                        <div class="col-6">@Model.Lecturer</div>
                        <div class="col-6 text-end fw-bold">Danh mục:</div>
                        <div class="col-6">@(Model.Category?.Name ?? "General")</div>
                    </div>
                </div>

                <div class="alert alert-warning border-0 text-start" role="alert" style="border-radius: 12px; background: rgba(255, 193, 7, 0.15); color: #664d03; font-size: 0.85rem;">
                    <i class="bi bi-info-circle-fill me-2"></i> <strong>Lưu ý:</strong> Khi bạn xóa học phần này, tất cả dữ liệu đăng ký lớp (Enrollments) liên quan của sinh viên đối với học phần này cũng sẽ bị xóa bỏ hoàn toàn khỏi hệ thống.
                </div>

                <!-- Form Actions -->
                <form asp-action="Delete" method="post">
                    <input type="hidden" asp-for="Id" />
                    <div class="d-flex justify-content-center gap-3 mt-4">
                        <a asp-action="Index" class="btn btn-light px-4 py-2 rounded-pill fw-medium text-dark">
                            Quay lại
                        </a>
                        <button type="submit" class="btn btn-danger px-4 py-2 rounded-pill fw-bold">
                            Xác nhận Xóa
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
