@model KT_LTWEB.Models.ViewModels.DashboardViewModel
@using KT_LTWEB.Models
@{
    ViewData["Title"] = "Dashboard Thống kê - Admin";
    var latestEnrollments = ViewBag.LatestEnrollments as List<Enrollment> ?? new List<Enrollment>();
}

<div class="container py-4">
    <div class="mb-4">
        <h1 class="h3 fw-bold text-dark mb-1">Dashboard Thống Kê</h1>
        <p class="text-secondary mb-0">Chào mừng quay trở lại, Admin. Dưới đây là số liệu tổng quan của hệ thống đăng ký học phần.</p>
    </div>

    <div class="row g-4 mb-4">
        <div class="col-md-4">
            <div class="card border-0 shadow-sm rounded-4 overflow-hidden text-white h-100" style="background: linear-gradient(135deg, #4f46e5 0%, #7c3aed 100%);">
                <div class="card-body p-4 d-flex justify-content-between align-items-center">
                    <div>
                        <h6 class="text-uppercase fw-semibold mb-2 opacity-80" style="font-size: 0.8rem; letter-spacing: 0.5px;">Tổng Số Học Phần</h6>
                        <h2 class="display-6 fw-bold mb-0">@Model.TotalCourses</h2>
                    </div>
                    <i class="bi bi-collection-fill display-4 opacity-50"></i>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card border-0 shadow-sm rounded-4 overflow-hidden text-white h-100" style="background: linear-gradient(135deg, #059669 0%, #10b981 100%);">
                <div class="card-body p-4 d-flex justify-content-between align-items-center">
                    <div>
                        <h6 class="text-uppercase fw-semibold mb-2 opacity-80" style="font-size: 0.8rem; letter-spacing: 0.5px;">Tổng Số Sinh Viên</h6>
                        <h2 class="display-6 fw-bold mb-0">@Model.TotalStudents</h2>
                    </div>
                    <i class="bi bi-people-fill display-4 opacity-50"></i>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card border-0 shadow-sm rounded-4 overflow-hidden text-white h-100" style="background: linear-gradient(135deg, #f59e0b 0%, #ef4444 100%);">
                <div class="card-body p-4 d-flex justify-content-between align-items-center">
                    <div>
                        <h6 class="text-uppercase fw-semibold mb-2 opacity-80" style="font-size: 0.8rem; letter-spacing: 0.5px;">Tổng Lượt Đăng Ký</h6>
                        <h2 class="display-6 fw-bold mb-0">@Model.TotalEnrollments</h2>
                    </div>
                    <i class="bi bi-clipboard-check-fill display-4 opacity-50"></i>
                </div>
            </div>
        </div>
    </div>

    <div class="row g-4">
        <div class="col-lg-8">
            <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
                <div class="card-header bg-white border-0 py-4 px-4">
                    <h5 class="fw-bold text-dark mb-1">Lượt Đăng Ký Mới Nhất</h5>
                    <p class="text-secondary small mb-0">Danh sách 5 sinh viên đăng ký học phần gần đây nhất.</p>
                </div>
                <div class="table-responsive">
                    <table class="table align-middle mb-0">
                        <thead style="background-color: #f8fafc;">
                            <tr class="text-secondary small text-uppercase">
                                <th class="ps-4 py-3">Sinh viên</th>
                                <th class="py-3">Học phần</th>
                                <th class="py-3">Ngày đăng ký</th>
                            </tr>
                        </thead>
                        <tbody>
                        @if (!latestEnrollments.Any())
                        {
                            <tr>
                                <td colspan="3" class="text-center py-5 text-muted">Chưa có lượt đăng ký học phần nào.</td>
                            </tr>
                        }
                        else
                        {
                            foreach (var enrollment in latestEnrollments)
                            {
                                <tr>
                                    <td class="ps-4">
                                        <span class="fw-bold text-dark">@(enrollment.User?.UserName ?? "N/A")</span>
                                        <small class="text-muted d-block fw-normal" style="font-size: 0.75rem;">@(enrollment.User?.Email ?? "")</small>
                                    </td>
                                    <td class="fw-medium text-dark">@(enrollment.Course?.Name ?? "N/A")</td>
                                    <td class="text-secondary">@enrollment.EnrollDate.ToString("dd/MM/yyyy HH:mm")</td>
                                </tr>
                            }
                        }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <div class="col-lg-4">
            <div class="card border-0 shadow-sm rounded-4">
                <div class="card-body p-4">
                    <h5 class="fw-bold text-dark mb-3">Thao Tác Nhanh</h5>
                    <div class="d-grid gap-2">
                        <a asp-controller="AdminCourses" asp-action="Index" class="btn btn-light text-start fw-medium py-3 rounded-3 d-flex justify-content-between align-items-center">
                            <span><i class="bi bi-collection-fill me-2"></i> Quản lý học phần</span>
                            <i class="bi bi-chevron-right"></i>
                        </a>
                        <a asp-controller="AdminCourses" asp-action="Create" class="btn btn-light text-start fw-medium py-3 rounded-3 d-flex justify-content-between align-items-center">
                            <span><i class="bi bi-plus-circle-fill me-2"></i> Thêm học phần mới</span>
                            <i class="bi bi-chevron-right"></i>
                        </a>
                        <a asp-controller="Home" asp-action="Index" class="btn btn-light text-start fw-medium py-3 rounded-3 d-flex justify-content-between align-items-center">
                            <span><i class="bi bi-house-door-fill me-2"></i> Xem trang chủ sinh viên</span>
                            <i class="bi bi-chevron-right"></i>
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
