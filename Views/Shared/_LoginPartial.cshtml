@using Microsoft.AspNetCore.Identity
@inject SignInManager<IdentityUser> SignInManager
@inject UserManager<IdentityUser> UserManager

<ul class="navbar-nav align-items-center gap-2">
@if (SignInManager.IsSignedIn(User))
{
    var roleDisplay = "";
    if (User.IsInRole("ADMIN") || User.IsInRole("Admin"))
    {
        roleDisplay = "Admin";
    }
    else if (User.IsInRole("STUDENT") || User.IsInRole("Student"))
    {
        roleDisplay = "Student";
    }

    <li class="nav-item">
        <span class="nav-link text-dark fw-medium">
            Chào, <strong class="text-primary">@User.Identity?.Name</strong> 
            @if (!string.IsNullOrEmpty(roleDisplay))
            {
                <span class="badge bg-secondary ms-1 small px-2 py-1" style="font-size:0.75rem; @(roleDisplay == "Admin" ? "background: #ef4444 !important;" : "background: #10b981 !important;")">@roleDisplay</span>
            }
        </span>
    </li>
    <li class="nav-item">
        <form class="form-inline" asp-controller="Account" asp-action="Logout" method="post">
            <button type="submit" class="btn btn-outline-danger rounded-pill px-3 py-1.5 fw-bold btn-sm shadow-sm-hover">
                <i class="bi bi-box-arrow-right me-1"></i> Đăng xuất
            </button>
        </form>
    </li>
}
else
{
    <li class="nav-item">
        <a class="btn btn-light rounded-pill px-4 py-1.5 fw-bold text-dark border-0" asp-controller="Account" asp-action="Register">Đăng Ký</a>
    </li>
    <li class="nav-item">
        <a class="btn btn-primary rounded-pill px-4 py-1.5 fw-bold text-white border-0 shadow-sm" asp-controller="Account" asp-action="Login" style="background: linear-gradient(135deg, #4f46e5 0%, #6366f1 100%);">Đăng Nhập</a>
    </li>
}
</ul>
