<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Course Registration</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/KT_LTWEB.styles.css" asp-append-version="true" />
</head>
<body style="font-family: 'Inter', sans-serif; background-color: #f8fafc;">
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom shadow-sm mb-4 py-3">
            <div class="container">
                <a class="navbar-brand fw-extrabold text-primary d-flex align-items-center" asp-controller="Home" asp-action="Index" style="font-size: 1.35rem; color: #4f46e5 !important; letter-spacing: -0.5px; font-weight: 800;">
                    <i class="bi bi-mortarboard-fill me-2"></i> CourseReg
                </a>
                <button class="navbar-toggler border-0" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1 ms-3">
                        <li class="nav-item">
                            <a class="nav-link text-secondary fw-semibold px-3" asp-controller="Home" asp-action="Index">Trang chủ</a>
                        </li>

                        @if (User.Identity != null && User.Identity.IsAuthenticated)
                        {
                            if (User.IsInRole("STUDENT") || User.IsInRole("Student"))
                            {
                                <li class="nav-item">
                                    <a class="nav-link text-secondary fw-semibold px-3" asp-controller="Enroll" asp-action="MyCourses">Học phần đã đăng ký</a>
                                </li>
                            }
                            else if (User.IsInRole("ADMIN") || User.IsInRole("Admin"))
                            {
                                <li class="nav-item">
                                    <a class="nav-link text-secondary fw-semibold px-3" asp-controller="AdminCourses" asp-action="Index">Quản lý học phần</a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link text-secondary fw-semibold px-3" asp-controller="Admin" asp-action="Dashboard">Thống kê</a>
                                </li>
                            }
                        }
                    </ul>
                    <partial name="_LoginPartial" />
                </div>
            </div>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-5">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted bg-white py-3 mt-5 position-relative">
        <div class="container text-center">
            &copy; 2026 - CourseReg - Hệ Thống Đăng Ký Học Phần
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
