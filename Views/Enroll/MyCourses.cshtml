@model IEnumerable<KT_LTWEB.Models.ViewModels.MyCoursesViewModel>
@{
    ViewData["Title"] = "Học phần đã đăng ký";
}

<div class="container py-4">
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show border-0 shadow-sm mb-4" role="alert" style="border-radius: 12px; background: rgba(25, 135, 84, 0.1); color: #198754;">
            <i class="bi bi-check-circle-fill me-2"></i> @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show border-0 shadow-sm mb-4" role="alert" style="border-radius: 12px; background: rgba(220, 53, 69, 0.1); color: #dc3545;">
            <i class="bi bi-exclamation-triangle-fill me-2"></i> @TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="h3 fw-bold text-dark mb-1">Học Phần Đã Đăng Ký</h1>
            <p class="text-secondary mb-0">Danh sách các học phần bạn đang theo học trong học kỳ này.</p>
        </div>
        <a asp-controller="Home" asp-action="Index" class="btn btn-primary rounded-pill px-4 fw-bold shadow-sm" style="background: #4f46e5; border: none;">
            <i class="bi bi-plus-circle me-1"></i> Đăng Ký Thêm Học Phần
        </a>
    </div>

    <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
        <div class="table-responsive">
            <table class="table align-middle mb-0">
                <thead style="background-color: #f8fafc;">
                    <tr class="text-secondary small text-uppercase">
                        <th class="ps-4 py-3">Tên học phần</th>
                        <th class="py-3">Số tín chỉ</th>
                        <th class="py-3">Giảng viên</th>
                        <th class="py-3">Ngày đăng ký</th>
                        <th class="pe-4 py-3 text-end" style="width: 180px;">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="5" class="text-center py-5">
                            <i class="bi bi-journal-x display-4 text-muted d-block mb-3"></i>
                            <span class="text-muted">Bạn chưa đăng ký học phần nào trong học kỳ này.</span>
                        </td>
                    </tr>
                }
                else
                {
                    foreach (var item in Model)
                    {
                        <tr>
                            <td class="ps-4 fw-bold text-dark">@item.CourseName</td>
                            <td>
                                <span class="fw-bold text-dark">@item.Credits</span> tín chỉ
                            </td>
                            <td class="text-secondary">@item.Lecturer</td>
                            <td class="text-secondary">@item.EnrollDate.ToString("dd/MM/yyyy HH:mm")</td>
                            <td class="pe-4 text-end">
                                <form asp-controller="Enroll" asp-action="Cancel" method="post" onsubmit="return confirm('Bạn có chắc chắn muốn hủy đăng ký học phần này?');">
                                    <input type="hidden" name="courseId" value="@item.CourseId" />
                                    <button type="submit" class="btn btn-outline-danger btn-sm rounded-pill px-3 fw-medium">
                                        <i class="bi bi-trash me-1"></i> Hủy đăng ký
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                }
                </tbody>
            </table>
        </div>
    </div>
</div>
